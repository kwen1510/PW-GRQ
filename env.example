# Server-only providers
OPENAI_API_KEY=
MONGO_URI=
MONGO_DB_NAME=pw_grq

# Cost/accuracy defaults
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# Authentication fails closed by default. This bypass is ignored in production/Vercel.
LOCAL_AUTH_BYPASS=false
LOCAL_PROMPT_ADMIN=false
ALLOWED_TEACHER_DOMAIN=ri.edu.sg
ALLOWED_TEACHER_EMAILS=teacher.one@ri.edu.sg,teacher.two@ri.edu.sg
PROMPT_ADMIN_EMAILS=

# Required before setting AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

PORT=3000
